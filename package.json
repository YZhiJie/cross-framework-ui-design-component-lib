{
  "name": "cross-framework-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "跨框架通用组件库 - 同时适配 Vue 3 与 React 17/18/19",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "e2e": "playwright test",
    "e2e:update-visual": "playwright test e2e/visual.spec.ts --update-snapshots",
    "gate": "tsx scripts/gate.ts",
    "release": "turbo build && changeset publish",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "sass": "^1.70.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-prettier": "^5.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^9.4.0"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  }
}
