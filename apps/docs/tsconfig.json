{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["vue", "react", "react-dom"],
    "paths": {
      "@xui/vue": ["../../packages/vue/src/index.ts"],
      "@xui/react": ["../../packages/react/src/index.ts"],
      "@xui/core": ["../../packages/core/src/index.ts"],
      "@xui/styles": ["../../packages/styles/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["dist", "node_modules"]
}
