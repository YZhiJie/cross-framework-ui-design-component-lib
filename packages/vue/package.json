{
  "name": "@xui-design/vue",
  "version": "0.2.0",
  "description": "跨框架组件库 - Vue 3 适配层",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*/index.mjs",
      "require": "./dist/components/*/index.cjs"
    }
  },
  "sideEffects": [
    "**/*.vue",
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@xui-design/core": "workspace:*",
    "@xui-design/shared": "workspace:*",
    "@xui-design/styles": "workspace:*",
    "@xui-design/icons": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vue-tsc": "^2.1.0",
    "@vue/test-utils": "^2.4.0",
    "unplugin-vue-components": "^0.27.0"
  }
}
