{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "types": ["react", "react-dom"],
    "paths": {
      "@xui/shared": ["../shared/dist/types/index.d.ts"],
      "@xui/shared/*": ["../shared/dist/types/*"],
      "@xui/core": ["../core/dist/types/index.d.ts"],
      "@xui/core/*": ["../core/dist/types/*"],
      "@xui/icons": ["../icons/dist/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
