{
  "name": "@xui/utils",
  "version": "0.0.0",
  "description": "跨框架组件库 - 通用工程工具（内部使用）",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./build/*": {
      "types": "./dist/types/build/*.d.ts",
      "import": "./dist/build/*.mjs",
      "require": "./dist/build/*.cjs"
    },
    "./test/*": {
      "types": "./dist/types/test/*.d.ts",
      "import": "./dist/test/*.mjs",
      "require": "./dist/test/*.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  }
}
